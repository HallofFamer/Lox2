namespace test.benchmarks

class Zoo {

    val Int aardvark
    val Int baboon
    val Int cat
    val Int donkey
    val Int elephant
    val Int fox

    __init__() {
        this.aardvark = 1
        this.baboon   = 1
        this.cat      = 1
        this.donkey   = 1
        this.elephant = 1
        this.fox      = 1
    }

    ant()    { return this.aardvark }
    banana() { return this.baboon }
    tuna()   { return this.cat }
    hay()    { return this.donkey }
    grass()  { return this.elephant }
    mouse()  { return this.fox }
}

val zoo = Zoo()
var sum = 0
val start = clock()
while (sum < 10000000) {
    sum = sum + zoo.ant() + zoo.banana() + zoo.tuna() + zoo.hay() + zoo.grass() + zoo.mouse()
}

println("Time taken for method calls: ${clock() - start} seconds")
println("Sum: ${sum}")